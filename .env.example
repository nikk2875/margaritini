# Copy to .env to override the local defaults. All settings are optional.

# Database used by both the API and Alembic. Relative SQLite paths are resolved
# against the backend/ directory.
# MARGARITINI_DATABASE_URL=sqlite:///./margaritini.db

# Browser origins allowed to call the API (JSON list).
# MARGARITINI_CORS_ORIGINS=["http://localhost:6002","http://127.0.0.1:6002"]

# Host headers the API accepts (JSON list). Keep this loopback-only.
# MARGARITINI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# Optional shared secret. When set, every API request must send it as
# X-Margaritini-Token; configure the web app with VITE_API_TOKEN to match.
# MARGARITINI_API_TOKEN=

# Limits for untrusted payloads.
# MARGARITINI_MAX_REQUEST_BYTES=5000000
# MARGARITINI_MAX_IMPORT_NODES=2000
# MARGARITINI_MAX_IMPORT_TASKS=20000
